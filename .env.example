# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (if applicable)
NEXT_PUBLIC_GA_ID=

# API Keys (Placeholders)
# MAPS_API_KEY=

# --- Contact / quote-request form email (Gmail SMTP via App Password) ---
# The sending Gmail account needs 2-Step Verification enabled; generate an
# App Password at https://myaccount.google.com/apppasswords and use it here
# (not the account's normal login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Recipient for quote-request submissions. Defaults to info@greentekenergy.co.uk
# in code if left blank.
CONTACT_TO_EMAIL=info@greentekenergy.co.uk

# --- Admin CMS (/admin) ---
# Login credentials for the single admin account. Set your own values —
# do not use these placeholders in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random long string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Content database (MongoDB Atlas) ---
# Connection string for the Atlas cluster (free M0 tier is fine). This is
# also required at BUILD time (generateStaticParams reads from it), so it
# must be set in Vercel's Project Environment Variables, not just locally.
MONGODB_URI=
MONGODB_DB=greentek

# --- Image uploads (Cloudinary) ---
# From your Cloudinary dashboard. The API secret is only ever used
# server-side to sign upload requests — never exposed to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=greentek
